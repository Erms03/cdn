  "capabilities": {
    "registration": {
      // El correo es el identificador de registro e inicio de sesión.
      "identifier": "email",
      "accountVerificationContact": "email",
      "contacts": {
        "email": { "presence": "required", "verify": true },
        "phone": { "presence": "optional", "verify": true },
      },
    },
    "onboarding": {
      "level": 3,
      // Pendiente de confirmar el flujo y la plantilla de contrato de IFPE.
      "contract": {
        "generationEndpoint": null,
        "templateId": null,
      },
    },
    "flags": {
      "biometricAuth": true,
      "camera": true,
      // monelo-app lo activa, pero esta app solo tiene tema claro.
      "darkMode": false,
      "documentScanner": true,
      "fileUpload": true,
      // monelo-app usa un degradado (#00427C → #0078E2 → #00CEB5) que esta app no consume.
      "gradient": false,
      "locationServices": true,
      "multiLanguage": false,
      "offlineMode": true,
      "pushNotifications": true,
      "qrCodeScanner": true,
      "socialLogin": false,
    },
    "wallet": {
      "modules": {
        // Equivale a creditAccounts de monelo-app (desactivado en Dyn).
        "accounts": {
          "add": {
            "enabled": false,
            "limit": 1,
          },
        },
        "biometric": true,
        "cards": true,
        "cashWithdrawal": false,
        "credit": false,
        "location": true,
        "nip": {
          "editable": true,
          "enabled": true,
        },
        "otp": true,
        "payrollLoan": false,
        "preventCapture": false,
        "servicePayments": true,
        "spei": {
          "in": {
            "clabe": false,
            "code": false,
            "reference": true,
          },
          "out": {
            "external": {
              "card": false,
              "clabe": false,
              "phone": false,
            },
            "internal": true,
          },
        },
        "transfers": true,
      },
      "otp": {
        "emailTemplate": "1589",
        "expiresAfterSeconds": 300,
        "length": 6,
        "resendAfterSeconds": 60,
        "smsTemplate": "1588",
      },
    },
  },
