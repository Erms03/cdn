    "theme": {
      // Primitivos y geometría global de HeroUI.
      // Figma no define variables propias para estos valores.
      "white": "#FFFFFF",
      "black": "#000000",
      "snow": "#FCFCFC",
      "eclipse": "#18181B",
      "borderWidth": "1px",
      "fieldBorderWidth": "1px",
      "radius": "0.5rem",
      "fieldRadius": "calc(var(--radius) * 1.75)",
      "opacityDisabled": "0.5",
      "theme": "default",

      // Colores semánticos — GajaPay.
      "background": "#F4F6F8",
      "foreground": "#111827",

      "surface": "#FFFFFF",
      "surfaceForeground": "#111827",

      "surfaceSecondary": "#E8F5EF",
      "surfaceSecondaryForeground": "#0F4F35",

      "surfaceTertiary": "#D9DEE5",
      "surfaceTertiaryForeground": "#374151",

      "overlay": "#FFFFFF",
      "overlayForeground": "#111827",
      "backdrop": "rgba(0, 0, 0, 0.20)",

      "muted": "#797979",

      "default": "#D9DEE5",
      "defaultForeground": "#374151",

      "accent": "#237E5A",
      "accentForeground": "#FFFFFF",

      "fieldBackground": "#FFFFFF",
      "fieldForeground": "#111827",
      "fieldPlaceholder": "#9CA3AF",
      "fieldBorder": "#D9DEE5",

      "success": "#16825D",
      "successForeground": "#FFFFFF",

      "warning": "#D98A00",
      "warningForeground": "#111827",

      "danger": "#EF4444",
      "dangerForeground": "#FFFFFF",

      "segment": "#FFFFFF",
      "segmentForeground": "#111827",

      "border": "#D9DEE5",
      "separator": "#D9DEE5",

      "focus": "#237E5A",
      "link": "#237E5A",

      // Figma no contiene variables o estilos de sombra específicos por marca.
      "surfaceShadow": "0 2px 4px 0 rgba(0, 0, 0, 0.04), 0 1px 2px 0 rgba(0, 0, 0, 0.06)",
      "overlayShadow": "0 2px 8px 0 rgba(0, 0, 0, 0.06)",
      "fieldShadow": "0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    },
  },
  // Capacidades que una marca puede activar o desactivar sin bifurcar el código.
  "capabilities": {
    "registration": {
      // Dato que se solicita para registrarse e iniciar sesión:
      // "email": correo electrónico completo como username.
      // "phone": número de celular internacional como username.
      // "username": nombre de usuario elegido por la persona.
      "identifier": "email",
      // Con identifier: "username", elige el primer contacto para confirmar: "email" o "phone".
      // Ese contacto debe tener presence: "required" y verify: true.
      // Si se omite, se prioriza el primer contacto obligatorio verificable (email, luego phone).
      // Con identifier: "email" o "phone" se utiliza el propio identificador.
      "accountVerificationContact": "email",
      "contacts": {
        // Las mismas opciones se aplican a email y phone, de forma independiente.
        // presence:
        //   "required": es obligatorio proporcionar el dato.
        //   "optional": se muestra, pero la persona puede omitirlo.
        //   "hidden": no se solicita ni se envía al crear la cuenta.
        // verify:
        //   true: exige verificar con un código si se proporciona el contacto.
        //   false: se guarda en PII y Cognito y se confirma automáticamente por backend, sin pedir código.
        // Combinaciones válidas para cada contacto:
        //   { "presence": "required", "verify": true }
        //   { "presence": "required", "verify": false }
        //   { "presence": "optional", "verify": true }
        //   { "presence": "optional", "verify": false }
        //   { "presence": "hidden", "verify": false }
        // Restricciones:
        // Si identifier es "email" o "phone", ese contacto siempre es required; verify puede ser true o false.
        // La app también fuerza esa regla al leer el JSON: el identificador nunca se oculta.
        // hidden + verify: true no está permitido. El generador valida estas reglas.
        "email": { "presence": "required", "verify": true },
        "phone": { "presence": "required", "verify": true },
      },
    },
    // Nivel de onboarding por app/compañía. null hasta definir su flujo.
    // Los números identifican niveles; las pantallas y su orden se definen en código.
    "onboarding": {
      "level": 3,
      // Flujo confirmado para esta compañía; configurable en otras marcas.
      "contract": {
        "generationEndpoint": "/internal/connector/22/flows/dcfd23776507449d8988554c5064418c",
        "templateId": 210,
      },
    },
    "flags": {
      "biometricAuth": true,
      "camera": true,
      "darkMode": false,
      "documentScanner": true,
      "fileUpload": true,
      "gradient": false,
      "locationServices": true,
      "multiLanguage": false,
      "offlineMode": false,
      "pushNotifications": false,
      "qrCodeScanner": true,
      "socialLogin": false,
    },
    "wallet": {
      "modules": {
        // "Agregar cuenta" en "Tus cuentas": la cuenta se agrega al activar la
        // tarjeta física que la acompaña (como creditAccounts en monelo).
        // limit: cuentas que puede tener el cliente; null sin límite.
        "accounts": {
          "add": {
            "enabled": false,
            "limit": null,
          },
        },
        "biometric": true,
        "cards": true,
        "cashWithdrawal": false,
        "credit": false,
        "location": true,
        "nip": {
          "editable": true,
          "enabled": true,
        },
        "otp": true,
        "payrollLoan": false,
        "preventCapture": false,
        "servicePayments": true,
        "spei": {
          "in": {
            "clabe": true,
            "code": true,
            "reference": true,
          },
          "out": {
            "external": {
              "card": true,
              "clabe": true,
              "phone": true,
            },
            "internal": true,
          },
        },
        "transfers": true,
      },
      "otp": {
        "emailTemplate": "REEMPLAZAR",
        "expiresAfterSeconds": 300,
        "length": 6,
        "resendAfterSeconds": 60,
        "smsTemplate": "REEMPLAZAR",
      },
    },
  },
